---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: longhorn
spec:
  chartRef:
    kind: OCIRepository
    name: longhorn
  interval: 1h
  values:
    preUpgradeChecker:
      jobEnabled: false
    persistence:
      defaultClass: true
      defaultClassReplicaCount: #{ longhorn.replica_count if longhorn.replica_count else [nodes | length, 3] | min }#
#% if longhorn.backup_target %#
    defaultBackupStore:
      backupTarget: "#{ longhorn.backup_target }#"
#% endif %#
