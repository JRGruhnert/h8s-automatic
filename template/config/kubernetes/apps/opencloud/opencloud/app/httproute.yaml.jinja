---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: opencloud
spec:
  parentRefs:
    - name: envoy-#{ 'external' if (opencloud.access in ['public', 'login']) else 'internal' }#
      namespace: network
      sectionName: https
  hostnames:
    - "cloud.${SECRET_DOMAIN}"
  rules:
    - backendRefs:
        - name: opencloud
          port: 9200
