---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: woodpecker
spec:
  parentRefs:
    - name: envoy-#{ 'external' if (woodpecker.access in ['public', 'login']) else 'internal' }#
      namespace: network
      sectionName: https
  hostnames:
    - "woodpecker.${SECRET_DOMAIN}"
  rules:
    - backendRefs:
        - name: woodpecker-server
          port: 80
