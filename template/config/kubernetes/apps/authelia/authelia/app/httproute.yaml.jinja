---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: authelia
spec:
  parentRefs:
    - name: envoy-#{ 'external' if (authelia.access in ['public', 'login']) else 'internal' }#
      namespace: network
      sectionName: https
  hostnames:
    - "idp.${SECRET_DOMAIN}"
  rules:
    - backendRefs:
        - name: authelia
          port: 9091
