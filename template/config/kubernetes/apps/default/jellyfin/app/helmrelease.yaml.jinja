---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: jellyfin
spec:
  chart:
    spec:
      chart: jellyfin
      version: 3.3.0
      sourceRef:
        kind: HelmRepository
        name: jellyfin
  interval: 1h
  values:
    persistence:
      config:
        size: "#{ jellyfin.config_size }#"
      media:
        type: pvc
        size: "#{ jellyfin.media_size }#"
