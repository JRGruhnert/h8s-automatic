---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: jellyfin
spec:
  parentRefs:
    - name: envoy-#{ 'external' if (jellyfin.access in ['public', 'login']) else 'internal' }#
      namespace: network
      sectionName: https
  hostnames:
    - "jellyfin.${SECRET_DOMAIN}"
  rules:
#% if jellyfin.access == 'login' %#
    - filters:
        - type: ExternalAuth
          externalAuth:
            protocol: HTTP
            backendRef:
              name: authelia
              namespace: authelia
              port: 9091
            http:
              path: /api/authz/ext-authz/
              allowedHeaders:
                - accept
                - cookie
                - authorization
                - proxy-authorization
                - x-forwarded-proto
              allowedResponseHeaders:
                - Remote-User
                - Remote-Groups
                - Remote-Name
                - Remote-Email
      backendRefs:
        - name: jellyfin
          port: 8096
#% else %#
    - backendRefs:
        - name: jellyfin
          port: 8096
#% endif %#
