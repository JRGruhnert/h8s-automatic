---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: navidrome
spec:
  parentRefs:
    - name: envoy-#{ 'external' if (navidrome.access in ['public', 'login']) else 'internal' }#
      namespace: network
      sectionName: https
  hostnames:
    - "navidrome.${SECRET_DOMAIN}"
  rules:
#% if navidrome.access == 'login' %#
    - filters:
        - type: ExternalAuth
          externalAuth:
            protocol: HTTP
            backendRef:
              name: authelia
              namespace: authelia
              port: 9091
            http:
              path: /api/authz/ext-authz/
              allowedHeaders:
                - accept
                - cookie
                - authorization
                - proxy-authorization
                - x-forwarded-proto
              allowedResponseHeaders:
                - Remote-User
                - Remote-Groups
                - Remote-Name
                - Remote-Email
      backendRefs:
        - name: navidrome
          port: 4533
#% else %#
    - backendRefs:
        - name: navidrome
          port: 4533
#% endif %#
